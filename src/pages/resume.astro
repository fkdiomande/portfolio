                  <div class="resume-lang-bar-fill" style={`width: ${lang.proficiency}%`}></div>
                </div>
              </li>
            ))}
          </ul>
        </section>
      </div>

      <!-- Experience: full width -->
      <section class="resume-main">
        <h2 class="resume-section-title resume-section-title-main">Experience</h2>
          <ol class="resume-experience">
            {experiences.map((exp) => (
              <li class="resume-experience-item">
                <header class="resume-exp-header">
                  <div class="resume-exp-heading">
                    <div class="resume-exp-title-row">
                      <h3 class="resume-exp-company">{exp.company}</h3>
                      <span class="resume-exp-field">{exp.field}</span>
                    </div>
                    <div class="resume-exp-meta">
                      <span class="resume-exp-position">{exp.position}</span>
                      <span class="resume-exp-dot">·</span>
                      <span class="resume-exp-period">{exp.period}</span>
                    </div>
                  </div>
                </header>
                <ul class="resume-exp-context">
                  {exp.context.map((c) => (
                    <li>{c}</li>
                  ))}
                </ul>

                <p class="resume-exp-desc">{exp.description}</p>

                <div class="resume-exp-block">
                  <h4 class="resume-exp-subtitle">Key contributions</h4>
                  <ul class="resume-exp-features">
                    {exp.features.map((feature) => (
                      <li>{feature}</li>
                    ))}
                  </ul>
                </div>

                <div class="resume-exp-block">
                  <h4 class="resume-exp-subtitle">Skills developed</h4>
                  <div class="resume-exp-skills">
                    {exp.skills.map((s) => (
                      <span class="resume-exp-skill-chip">{s}</span>
                    ))}
                  </div>
                </div>

                <div class="resume-exp-block">
                  <h4 class="resume-exp-subtitle">Tech stack</h4>
                  <div class="resume-exp-tech">
                    {exp.tech.map((t) => (
                      <span class="resume-exp-tech-chip">{t}</span>
                    ))}
                  </div>
                </div>
              </li>
            ))}
          </ol>
        </section>
    </article>
  </main>
</Layout>

<style>
  /* Page-level */
  .resume-page {
