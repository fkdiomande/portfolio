const techStack = [
  { label: "Languages", items: ["TypeScript", "JavaScript", "Python", "SQL", "HTML", "CSS"] },
  { label: "Front-End", items: ["React", "Tailwind CSS"] },
  { label: "Back-End", items: ["Node.js", "NestJS", "FastAPI", "REST APIs", "Microservices"] },
  { label: "Databases", items: ["PostgreSQL", "MongoDB", "Cassandra", "Redis", "RabbitMQ"] },
  { label: "DevOps & Cloud", items: ["Docker", "Kubernetes", "AWS", "Terraform", "GitHub Actions"] },
  { label: "AI & Agentic", items: ["LangChain", "CrewAI", "OpenRouter", "LanceDB", "Pinecone", "RAG", "MCP"] },
  { label: "Testing", items: ["Jest", "Bun test", "PyTest", "Vitest"] },
