  },
  {
    company: "Wiztrust",
    position: "Software Engineer",
    period: "Oct 2011 — Sep 2012",
    field: "PR Tech / SaaS",
    context: ["GDPR-compliant", "EU hosting", "Listed-company clients", "Blockchain certification"],
    description:
      "All-in-one, GDPR-compliant PR and communications platform helping corporate communication teams manage newsrooms, media databases, multichannel press distribution, and performance analytics — with blockchain-backed certification of corporate information.",
