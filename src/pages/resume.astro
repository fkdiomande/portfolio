const softSkills = [
  { name: "Adaptability", detail: "Thrives in fast-changing contexts and evolving requirements." },
  { name: "Collaboration", detail: "Communicates clearly across product, design, and engineering." },
  { name: "Problem-Solving", detail: "Breaks down ambiguity into shipped, measurable outcomes." },
  { name: "Organization", detail: "Plans roadmaps, priorities, and dependencies end-to-end." },
  { name: "Design Thinking", detail: "Combines UX sensitivity with engineering pragmatism." },
];

const languages = [
  { name: "French", level: "Native", proficiency: 100 },
  { name: "English", level: "Fluent", proficiency: 85 },
];

const experiences = [
  {
    company: "Ooneex",
    position: "Lead Developer",
    period: "Oct 2024 — Mar 2026",
    field: "EdTech / SaaS",
    context: ["Vertical SaaS", "Medical education", "Multi-tenant", "AI-assisted"],
    description:
      "Vertical SaaS platform for medical education unifying content management, scheduling, assessments, and analytics into a single classroom workspace — empowering educators and students to organize, study, and track entire courses from one place.",
    features: [
      "Built an interactive classroom dashboard providing high-level course overviews with year-level tagging, ownership, and participant management.",
      "Developed a rich resource library supporting books, videos, images, notes, MCQ decks, flashcard decks, and clinical case decks with AI-powered chat.",
      "Engineered an agenda and events management system for tutorials, labs, workshops, and exams with priority tracking and weekly analytics.",
      "Implemented a folder-based content organization system with per-topic resource counts, favorites, and granular access control.",
      "Created a resource analytics engine with format distribution charts and top-folder rankings.",
      "Designed a credits-based monetization system separating free and premium content folders.",
    ],
    skills: [
      "SaaS architecture & multi-tenant design",
      "AI integration (RAG, conversational agents)",
      "Real-time data analytics & dashboards",
      "Payment & credits system design",
      "Team leadership & code review",
    ],
    tech: ["React", "Tailwind CSS", "TypeScript", "Node.js", "Python", "Docker", "AWS", "Terraform", "LangChain"],
  },
  {
    company: "Mata Capital",
    position: "Lead Developer",
    period: "Sep 2020 — Oct 2024",
    field: "Real Estate / FinTech",
    context: ["~€2.4B AUM", "France & Germany", "Paris · Lyon · Hamburg", "70+ professionals served"],
    description:
      "Independent real estate investment firm managing ~€2.4B in assets across France and Germany — combining investment management, investor solutions, and asset management with a strong focus on innovation, ESG, and long-term value creation.",
