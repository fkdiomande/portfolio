import Layout from "@/layouts/Layout.astro";

const profile = {
  name: "Franck DIOMANDE",
  title: "Fullstack Web Developer",
  yearsOfExperience: "14+ years",
  summary:
    "Fullstack engineer with 14+ years building production-grade web applications end-to-end. I design, ship, and lead — combining strong front-end craft, resilient back-end architecture, and modern AI/agentic systems. Comfortable owning the stack from React UIs to cloud infrastructure on AWS, and equally at home shaping product direction with stakeholders or mentoring engineers in code review.",
  approach: [
    "Ship small, ship often — value and feedback over big-bang releases.",
    "Design systems first — consistency, accessibility, and long-term maintainability.",
    "Measure before optimizing — profiling, observability, and data-driven decisions.",
    "Mentor by example — code reviews, pair programming, and shared architecture ownership.",
  ],
  contact: {
    email: "fkdiomande@icloud.com",
    website: "fkdiomande.com",
    github: "github.com/fkdiomande",
    linkedin: "linkedin.com/in/fkdiomande",
  },
};

const techCategories = [
  {
    label: "Frontend",
    icons: [
      { icon: typescriptIcon, name: "TypeScript" },
      { icon: reactIcon, name: "React" },
      { icon: tailwindIcon, name: "Tailwind CSS" },
    ],
  },
  {
    label: "Backend",
    icons: [
      { icon: nodeIcon, name: "Node.js" },
      { icon: nestIcon, name: "NestJS" },
      { icon: pythonIcon, name: "Python" },
      { icon: fastApiIcon, name: "FastAPI" },
    ],
  },
  {
    label: "Databases",
    icons: [
      { icon: postgresIcon, name: "PostgreSQL" },
      { icon: mongodbIcon, name: "MongoDB" },
      { icon: cassandraIcon, name: "Cassandra" },
      { icon: redisIcon, name: "Redis" },
      { icon: rabbitMqIcon, name: "RabbitMQ" },
    ],
  },
  {
    label: "DevOps",
    icons: [
      { icon: dockerIcon, name: "Docker" },
      { icon: kubernetesIcon, name: "Kubernetes" },
      { icon: awsIcon, name: "AWS" },
      { icon: terraformIcon, name: "Terraform" },
    ],
  },
  {
    label: "AI & Agent",
    icons: [
      { icon: langchainIcon, name: "LangChain" },
      { icon: lancedbIcon, name: "LanceDB" },
      { icon: openrouterIcon, name: "OpenRouter" },
    ],
  },
];

const companies = [
  {
    logo: metaLogo,
    name: "Meta",
    field: "Social Media",
    description: "Operates Facebook, Instagram, and WhatsApp — social platforms used by billions worldwide.",
    logoClass: "resume-logo-meta",
  },
  {
    logo: airLiquide,
    name: "Air Liquide",
    field: "Industrial Gases",
    description: "World leader in gases, technologies, and services for industry and healthcare in 70+ countries.",
    logoClass: "",
  },
  {
    logo: mata,
    name: "Mata Capital",
    field: "Real Estate",
    description: "Real estate investment manager with over €1.5bn in assets under management.",
    logoClass: "",
  },
  {
    logo: ooneex,
    name: "Ooneex",
    field: "EdTech",
    description: "Medical study platform that turns lecture notes into smart, exam-ready flashcards.",
    logoClass: "",
  },
  {
    logo: wiztrust,
    name: "Wiztrust",
    field: "Corporate Comms",
    description:
      "PR platform that lets corporate communication teams certify and distribute content on the blockchain.",
    logoClass: "",
  },
  {
    logo: deltaRm,
    name: "Delta RM",
    field: "Risk Management",
    description: "SaaS for enterprise risk, incidents, insurance, and internal control management.",
    logoClass: "",
  },
];

const highlights = [
  { metric: "€2.4B", label: "AUM", detail: "Platform tooling at Mata Capital across France & Germany" },
  { metric: "4M+", label: "Users", detail: "Patient & customer portals at Air Liquide" },
  { metric: "59", label: "Countries", detail: "Covered by Air Liquide multi-region apps" },
  { metric: "80+", label: "Engineers", detail: "International agile team at Facebook" },
  { metric: "70+", label: "Pros served", detail: "Decision-makers using Mata Capital data tools" },
];

const coreSkills = [
  {
    title: "Front-End",
    description: "Performant, accessible, design-system-driven UIs.",
    detail: "React, TypeScript, Tailwind — component libraries, a11y (WCAG), motion, perf budgets.",
  },
  {
    title: "Back-End",
    description: "Robust APIs, secure services, scalable data layers.",
    detail: "Node.js, NestJS, FastAPI — REST, microservices, event-driven patterns, observability.",
  },
  {
    title: "AI & Agent",
    description: "RAG, multi-agent systems, LLM routing & orchestration.",
    detail: "LangChain, CrewAI, OpenRouter, vector DBs (LanceDB, Pinecone), MCP tool integrations.",
  },
  {
    title: "Dev & Ops",
    description: "Cloud infra, CI/CD, IaC, container orchestration.",
    detail: "AWS, Docker, Kubernetes, Terraform, GitHub Actions — from zero-to-prod pipelines.",
  },
  {
    title: "Leadership",
    description: "Mentoring engineers, code review, technical direction.",
    detail: "Architecture reviews, hiring & onboarding, roadmap alignment with product stakeholders.",
  },
  {
