---
import { Image } from "astro:assets";
import profileImage from "@/assets/franck-diomande.jpeg";
import emailIcon from "@/assets/social/email.svg";
import githubIcon from "@/assets/social/github.svg";
import instagramIcon from "@/assets/social/instagram.svg";
import linkedinIcon from "@/assets/social/linkedin.svg";
import tailwindIcon from "@/assets/tech/expertise/tailwindcss.svg";
import typescriptIcon from "@/assets/tech/expertise/typescript.svg";
import Avatar from "@/components/ui/avatar/Avatar.astro";
import AvatarImage from "@/components/ui/avatar/AvatarImage.astro";
import Muted from "@/components/ui/typography/Muted.astro";
import Small from "@/components/ui/typography/Small.astro";

const year = new Date().getFullYear();

const navLinks = [
  { label: "Skills", href: "#skills" },
  { label: "Frontend", href: "#frontend" },
  { label: "Backend", href: "#backend" },
  { label: "AI & Agents", href: "#ai" },
  { label: "DevOps", href: "#dev-ops" },
  { label: "Experiences", href: "#experiences" },
];

const socials = [
  { icon: githubIcon, name: "GitHub", href: "https://github.com/fkdiomande", handle: "@fkdiomande" },
  {
    icon: linkedinIcon,
    name: "LinkedIn",
    href: "https://linkedin.com/in/fkdiomande",
    handle: "in/fkdiomande",
  },
  { icon: emailIcon, name: "Email", href: "mailto:fkdiomande@icloud.com", handle: "fkdiomande@icloud.com" },
];

const builtWith = [
  { icon: typescriptIcon, name: "TypeScript" },
  { icon: tailwindIcon, name: "Tailwind CSS" },
];
---

<footer data-slot="footer" class="footer-section relative overflow-hidden bg-[#0a0a12] text-white">
  <!-- Top gradient border -->
  <div class="absolute top-0 left-0 right-0 h-px bg-linear-to-r from-transparent via-primary to-transparent opacity-60"></div>

  <!-- Background decorations -->
  <div class="absolute inset-0 bg-[radial-gradient(circle,rgba(255,255,255,0.04)_1px,transparent_1px)] [background-size:24px_24px] opacity-50"></div>
  <div class="absolute rounded-full blur-[130px] opacity-[0.25] pointer-events-none w-[600px] h-[600px] bg-primary -top-[250px] -left-[150px]"></div>
  <div class="absolute rounded-full blur-[130px] opacity-[0.20] pointer-events-none w-[500px] h-[500px] bg-secondary -bottom-[200px] -right-[100px]"></div>

  <div class="relative z-10 mx-auto max-w-6xl px-6 py-16 sm:py-20">
    <!-- Main grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-10 mb-14">
      <!-- Brand -->
      <div class="lg:col-span-4 flex flex-col gap-5">
        <div class="flex items-center gap-3">
          <div class="relative rounded-full p-[2px] bg-linear-to-br from-primary to-secondary shrink-0">
            <Avatar size="md" class="size-12! ring-1 ring-white/10">
              <AvatarImage src={profileImage.src} alt="Franck DIOMANDE" />
            </Avatar>
          </div>
          <div class="flex flex-col gap-2">
            <span class="font-black text-lg tracking-tight leading-none">Franck DIOMANDE</span>
            <Small class="text-white/50 font-mono text-2xs tracking-wider">LEAD FULL-STACK WEB DEVELOPER</Small>
          </div>
        </div>
        <p class="text-sm text-white/60 leading-relaxed">
          Turning ideas into production-ready products with modern tools, clean architecture, and a lot of care for the details.
        </p>
      </div>

      <!-- Navigation -->
      <div class="lg:col-span-3 flex flex-col gap-4">
        <Muted class="text-2xs font-semibold tracking-widest text-white/40 uppercase">Explore</Muted>
        <ul class="flex flex-col gap-2.5 list-none p-0 m-0">
          {navLinks.map(({ label, href }) => (
            <li>
              <a
                href={href}
                class="group inline-flex items-center gap-2 text-sm text-white/70 transition-colors duration-200 hover:text-white"
              >
                <span class="size-1 rounded-full bg-white/20 group-hover:bg-secondary transition-colors duration-200"></span>
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Connect -->
      <div class="lg:col-span-5 flex flex-col gap-4">
        <Muted class="text-2xs font-semibold tracking-widest text-white/40 uppercase">Let's connect</Muted>
        <ul class="flex flex-col gap-2.5 list-none p-0 m-0">
          {socials.map(({ icon, name, href, handle }) => (
            <li>
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                class="group inline-flex items-center gap-3 text-sm text-white/70 transition-colors duration-200 hover:text-white"
                aria-label={name}
              >
                <span class="flex items-center justify-center size-7 rounded-md bg-white/5 border border-white/10 transition-all duration-200 group-hover:bg-white/10 group-hover:border-white/20">
                  <Image src={icon} alt={name} width={14} height={14} class="opacity-80 [filter:invert(1)_brightness(1.5)]" />
                </span>
                <span class="font-mono text-xs truncate">{handle}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

    </div>

    <!-- Terminal strip -->
    <div class="mb-10 rounded-lg border border-white/10 bg-black/40 backdrop-blur-sm overflow-hidden">
      <!-- Terminal header -->
      <div class="flex items-center gap-2 px-4 py-2 border-b border-white/5 bg-white/[0.02]">
        <span class="size-2.5 rounded-full bg-red-400/70"></span>
        <span class="size-2.5 rounded-full bg-yellow-400/70"></span>
        <span class="size-2.5 rounded-full bg-green-400/70"></span>
        <Small class="ml-2 font-mono text-2xs text-white/40 tracking-wider">franck@portfolio ~ %</Small>
      </div>
      <!-- Terminal body -->
      <div class="px-4 py-3 font-mono text-xs text-white/70 flex flex-wrap items-center gap-x-3 gap-y-1">
        <span class="text-green-400">$</span>
        <span class="text-white/50">whoami</span>
        <span class="text-white/30">→</span>
        <span>passionate about</span>
        <span class="text-secondary">clean code</span>
        <span class="text-white/30">·</span>
        <span class="text-secondary">crafted UI</span>
        <span class="text-white/30">·</span>
        <span class="text-secondary">scalable systems</span>
        <span class="text-white/30">·</span>
        <span class="text-secondary">shipping fast</span>
        <span class="inline-block w-2 h-4 bg-white/80 ml-1 animate-[blink_1s_step-end_infinite]" aria-hidden="true"></span>
      </div>
    </div>

    <!-- Bottom strip -->
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6 pt-8 border-t border-white/10">
      <div class="flex flex-col gap-1">
        <Small class="text-xs text-white/50">
          © {year} Franck DIOMANDE.
        </Small>
        <div class="flex items-center gap-2">
          <Small class="text-2xs text-white/30 font-mono tracking-wider">BUILT WITH</Small>
          <div class="flex items-center gap-1.5">
            {builtWith.map(({ name }) => (
              <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded border border-white/10 bg-white/[0.02]" title={name}>
                <span class="font-mono text-[0.6rem] text-white/50">{name}</span>
              </span>
            ))}
            <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded border border-white/10 bg-white/[0.02]">
              <span class="font-mono text-[0.6rem] text-white/50">Astro</span>
            </span>
          </div>
        </div>
      </div>

      <div class="flex items-center gap-4">
        <a
          href="#top"
          class="group inline-flex items-center gap-2 px-4 py-2 rounded-md border border-white/10 bg-white/[0.03] transition-all duration-200 hover:bg-white/[0.08] hover:border-white/20"
          aria-label="Back to top"
        >
          <Small class="text-xs font-mono text-white/60 group-hover:text-white tracking-wider">BACK TO TOP</Small>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white/60 group-hover:text-white transition-transform duration-200 group-hover:-translate-y-0.5" aria-hidden="true">
            <path d="m5 12 7-7 7 7"/>
            <path d="M12 19V5"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>

<style is:global>
  @keyframes blink {
    0%, 50% { opacity: 1; }
    50.01%, 100% { opacity: 0; }
  }
</style>

<script>
  const formatTime = () => {
    const formatter = new Intl.DateTimeFormat("en-GB", {
      timeZone: "Europe/Paris",
      hour: "2-digit",
      minute: "2-digit",
      hour12: false,
    });
    return `${formatter.format(new Date())} CET`;
  };

  const updateClock = () => {
    const el = document.getElementById("footer-clock");
    if (el) el.textContent = formatTime();
  };

  updateClock();
  setInterval(updateClock, 30_000);
</script>
</content>
</invoke>
