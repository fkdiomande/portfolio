---
import { Image } from "astro:assets";
import awsIcon from "@/assets/tech/expertise/aws.svg";
import dockerIcon from "@/assets/tech/expertise/docker.svg";
import kubernetesIcon from "@/assets/tech/expertise/kubernetes.svg";
import terraformIcon from "@/assets/tech/expertise/terraform.svg";
import Chip from "@/components/ui/chip/Chip.astro";
import H2 from "@/components/ui/typography/H2.astro";
import Muted from "@/components/ui/typography/Muted.astro";

const description =
  "I orchestrate the seamless harmony between development and operations. My expertise lies in crafting pipelines, automating workflows, and fortifying the scalability and reliability of cloud infrastructure.";

const items = [
  {
    icon: dockerIcon,
    name: "Docker",
    description: "Containerizing applications for consistent environments across development, staging, and production.",
    category: "Containerization",
    status: "running",
  },
  {
    icon: kubernetesIcon,
    name: "Kubernetes",
    description: "Orchestrating containerized workloads with auto-scaling, self-healing, and rolling deployments.",
    category: "Orchestration",
    status: "running",
  },
  {
    icon: awsIcon,
    name: "AWS",
    description: "Architecting cloud infrastructure with EC2, S3, Lambda, RDS, and other managed services.",
    category: "Cloud",
    status: "running",
  },
  {
    icon: terraformIcon,
    name: "Terraform",
    description: "Defining infrastructure as code for reproducible, version-controlled cloud environments.",
    category: "IaC",
    status: "running",
  },
] as const;
---

<section data-slot="dev-ops" class="devops-section relative overflow-hidden py-20 sm:py-24">
  <!-- Subtle dot pattern -->
  <div class="absolute inset-0 bg-[radial-gradient(circle,rgba(124,58,237,0.06)_1px,transparent_1px)] [background-size:24px_24px]"></div>

  <!-- Soft gradient orbs -->
  <div class="absolute rounded-full blur-[120px] opacity-[0.08] pointer-events-none w-[600px] h-[600px] bg-[#7c3aed] -top-[200px] -right-[150px]"></div>
  <div class="absolute rounded-full blur-[120px] opacity-[0.08] pointer-events-none w-[500px] h-[500px] bg-[#a855f7] -bottom-[200px] -left-[150px]"></div>

  <div class="relative z-10 mx-auto max-w-6xl px-6">
    <div class="flex flex-col items-center gap-3 text-center mb-10">
      <Muted class="text-2xs font-semibold tracking-widest opacity-60">Shipping with confidence</Muted>
      <H2 class="border-0 text-3xl sm:text-4xl font-black tracking-tight">
        Dev & <span class="bg-linear-to-br from-[#7c3aed] via-[#a855f7] to-[#6366f1] bg-clip-text text-transparent">Ops</span>
      </H2>
    </div>

    <!-- Description -->
    <div class="mx-auto max-w-3xl text-center mb-14">
      <p class="text-base sm:text-lg leading-relaxed text-muted-foreground">{description}</p>
    </div>

    <!-- Pipeline cards -->
    <div class="relative grid grid-cols-4 gap-6 max-[900px]:grid-cols-2 max-[900px]:gap-x-5 max-[900px]:gap-y-8 max-[540px]:grid-cols-1 max-[540px]:gap-x-6 max-[540px]:gap-y-6">
      {items.map((item, i) => (
        <div class="relative flex flex-col items-center gap-4">
          {/* Connector line between cards */}
          {i < items.length - 1 && (
            <div class="absolute top-[18px] left-[calc(50%+20px)] right-[calc(-50%+20px)] h-0.5 z-[1] bg-linear-to-r from-[#7c3aed] to-[#7c3aed]/15 max-[900px]:hidden" />
          )}

          {/* Step number */}
          <div class="relative w-[38px] h-[38px] rounded-full bg-linear-to-br from-[#7c3aed] to-[#a855f7] flex items-center justify-center z-[2] shrink-0">
            <span class="font-mono text-xs font-bold text-white">{String(i + 1).padStart(2, "0")}</span>
          </div>

          {/* Card */}
          <div class="w-full flex-1 text-xs bg-card text-card-foreground rounded-[var(--radius)] p-5 transition-all duration-300 cursor-pointer shadow-[0_0_0_0.4px_var(--color-card-ring)] hover:shadow-[0_0_0_0.4px_var(--color-ring-alt)] hover:-translate-y-[3px]">
            <div class="flex items-start justify-between mb-3.5">
              <div class="w-12 h-12 rounded-xl bg-[#7c3aed]/[0.04] border border-[#7c3aed]/[0.08] flex items-center justify-center">
                <Image src={item.icon} alt={item.name} width={32} height={32} />
              </div>
              <div class="flex flex-col items-end gap-[0.35rem]">
                <Chip>{item.category}</Chip>
                <span class="flex items-center gap-[0.3rem] font-mono text-[0.6rem] font-medium text-[#22c55e]">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#22c55e]" />
                  {item.status}
                </span>
              </div>
            </div>
            <h3 class="text-base font-bold text-[#1e293b] mb-[0.4rem]">{item.name}</h3>
            <p class="text-[0.78rem] leading-[1.6] text-[#64748b] mb-4">{item.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style is:global>
  @keyframes fill-bar {
    to {
      transform: scaleX(1);
    }
  }
</style>
