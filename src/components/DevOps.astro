---
import { Image } from "astro:assets";
import awsIcon from "@/assets/tech/expertise/aws.svg";
import dockerIcon from "@/assets/tech/expertise/docker.svg";
import kubernetesIcon from "@/assets/tech/expertise/kubernetes.svg";
import terraformIcon from "@/assets/tech/expertise/terraform.svg";
import H2 from "@/components/ui/typography/H2.astro";
import Muted from "@/components/ui/typography/Muted.astro";

const description =
  "I orchestrate the seamless harmony between development and operations. My expertise lies in crafting pipelines, automating workflows, and fortifying the scalability and reliability of cloud infrastructure.";

const items = [
  {
    icon: dockerIcon,
    name: "Docker",
    description: "Containerizing applications for consistent environments across development, staging, and production.",
    category: "Containerization",
    status: "running",
  },
  {
    icon: kubernetesIcon,
    name: "Kubernetes",
    description: "Orchestrating containerized workloads with auto-scaling, self-healing, and rolling deployments.",
    category: "Orchestration",
    status: "running",
  },
  {
    icon: awsIcon,
    name: "AWS",
    description: "Architecting cloud infrastructure with EC2, S3, Lambda, RDS, and other managed services.",
    category: "Cloud",
    status: "running",
  },
  {
    icon: terraformIcon,
    name: "Terraform",
    description: "Defining infrastructure as code for reproducible, version-controlled cloud environments.",
    category: "IaC",
    status: "running",
  },
] as const;
---

<section data-slot="dev-ops" class="devops-section relative overflow-hidden py-20 sm:py-24">
  <!-- Subtle dot pattern -->
  <div class="devops-bg absolute inset-0"></div>

  <!-- Soft gradient orbs -->
  <div class="devops-orb devops-orb-1"></div>
  <div class="devops-orb devops-orb-2"></div>

  <div class="relative z-10 mx-auto max-w-6xl px-6">
    <div class="flex flex-col items-center gap-3 text-center mb-10">
      <Muted class="text-2xs font-semibold tracking-widest opacity-60">Shipping with confidence</Muted>
      <H2 class="border-0 text-3xl sm:text-4xl font-black tracking-tight">
        Dev & <span class="devops-gradient-text">Ops</span>
      </H2>
    </div>

    <!-- Description -->
    <div class="mx-auto max-w-3xl text-center mb-14">
      <p class="text-base sm:text-lg leading-relaxed text-muted-foreground">{description}</p>
    </div>

    <!-- Pipeline cards -->
    <div class="pipeline">
      {items.map((item, i) => (
        <div class="pipeline-step">
          {/* Connector line between cards */}
          {i < items.length - 1 && <div class="pipeline-connector" />}

          {/* Step number */}
          <div class="pipeline-number">
            <span class="pipeline-number-text">{String(i + 1).padStart(2, "0")}</span>
            <span class="pipeline-pulse" />
          </div>

          {/* Card */}
          <div class="pipeline-card">
            <div class="pipeline-card-top">
              <div class="pipeline-icon">
                <Image src={item.icon} alt={item.name} width={32} height={32} />
              </div>
              <div class="pipeline-meta">
                <span class="pipeline-category">{item.category}</span>
                <span class="pipeline-status">
                  <span class="pipeline-status-dot" />
                  {item.status}
                </span>
              </div>
            </div>
            <h3 class="pipeline-name">{item.name}</h3>
            <p class="pipeline-desc">{item.description}</p>
            <div class="pipeline-bar">
              <div class="pipeline-bar-fill" style={`animation-delay: ${i * 0.3}s;`} />
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .devops-gradient-text {
    background: linear-gradient(135deg, #7c3aed 0%, #a855f7 50%, #6366f1 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .devops-bg {
    background-color: transparent;
    background-image: radial-gradient(circle, rgba(124, 58, 237, 0.06) 1px, transparent 1px);
    background-size: 24px 24px;
  }

  .devops-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.08;
    pointer-events: none;
  }

  .devops-orb-1 {
    width: 600px;
    height: 600px;
    background: #7c3aed;
    top: -200px;
    right: -150px;
  }

  .devops-orb-2 {
    width: 500px;
    height: 500px;
    background: #a855f7;
    bottom: -200px;
    left: -150px;
  }

  /* Pipeline layout */
  .pipeline {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    position: relative;
  }

  .pipeline-step {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  /* Connector line between steps */
  .pipeline-connector {
    position: absolute;
    top: 18px;
    left: calc(50% + 20px);
    right: calc(-50% + 20px);
    height: 2px;
    background: linear-gradient(90deg, #7c3aed 0%, rgba(124, 58, 237, 0.15) 100%);
    z-index: 1;
  }

  /* Step number circle */
  .pipeline-number {
    position: relative;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: linear-gradient(135deg, #7c3aed, #a855f7);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    flex-shrink: 0;
  }

  .pipeline-number-text {
    font-family: "JetBrains Mono", "Fira Code", monospace;
    font-size: 0.75rem;
    font-weight: 700;
    color: white;
  }

  .pipeline-pulse {
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    border: 2px solid rgba(124, 58, 237, 0.3);
    animation: pulse-ring 2s ease-out infinite;
  }

  @keyframes pulse-ring {
    0% {
      transform: scale(1);
      opacity: 1;
    }
    100% {
      transform: scale(1.5);
      opacity: 0;
    }
  }

  /* Card */
  .pipeline-card {
    width: 100%;
    background: var(--color-card);
    color: var(--color-card-foreground);
    border-radius: var(--radius);
    padding: 1.25rem;
    transition: all 0.3s ease;
    flex: 1;
    box-shadow: 0 0 0 0.4px var(--color-card-ring);
  }

  .pipeline-card:hover {
    box-shadow: 0 0 0 0.4px var(--color-ring-alt);
    transform: translateY(-3px);
    cursor: pointer;
  }

  .pipeline-card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 0.875rem;
  }

  .pipeline-icon {
    width: 48px;
    height: 48px;
    border-radius: 0.75rem;
    background: rgba(124, 58, 237, 0.04);
    border: 1px solid rgba(124, 58, 237, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pipeline-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.35rem;
  }

  .pipeline-category {
    font-family: "JetBrains Mono", "Fira Code", monospace;
    font-size: 0.6rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #7c3aed;
    background: rgba(124, 58, 237, 0.06);
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
  }

  .pipeline-status {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-family: "JetBrains Mono", "Fira Code", monospace;
    font-size: 0.6rem;
    font-weight: 500;
    color: #22c55e;
  }

  .pipeline-status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #22c55e;
    animation: blink-dot 2s ease-in-out infinite;
  }

  @keyframes blink-dot {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  .pipeline-name {
    font-size: 1rem;
    font-weight: 700;
    color: #1e293b;
    margin-bottom: 0.4rem;
  }

  .pipeline-desc {
    font-size: 0.78rem;
    line-height: 1.6;
    color: #64748b;
    margin-bottom: 1rem;
  }

  /* Progress bar */
  .pipeline-bar {
    height: 3px;
    border-radius: 9999px;
    background: rgba(124, 58, 237, 0.08);
    overflow: hidden;
  }

  .pipeline-bar-fill {
    height: 100%;
    width: 100%;
    border-radius: 9999px;
    background: linear-gradient(90deg, #7c3aed, #a855f7);
    animation: fill-bar 2.5s ease-out forwards;
    transform-origin: left;
    transform: scaleX(0);
  }

  @keyframes fill-bar {
    to {
      transform: scaleX(1);
    }
  }

  /* Responsive */
  @media (max-width: 900px) {
    .pipeline {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem 1.25rem;
    }

    .pipeline-connector {
      display: none;
    }
  }

  @media (max-width: 540px) {
    .pipeline {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
