---
import H2 from "@/components/ui/typography/H2.astro";
import Muted from "@/components/ui/typography/Muted.astro";
import { Image } from "astro:assets";
import biomeIcon from "@/assets/tech/expertise/biome.svg";
import bunIcon from "@/assets/tech/expertise/bun.svg";
import cssIcon from "@/assets/tech/expertise/css.svg";
import eslintIcon from "@/assets/tech/expertise/eslint.svg";
import htmlIcon from "@/assets/tech/expertise/html.svg";
import javascriptIcon from "@/assets/tech/expertise/javascript.svg";
import jestIcon from "@/assets/tech/expertise/jest.svg";
import npmIcon from "@/assets/tech/expertise/npm.svg";
import reactIcon from "@/assets/tech/expertise/react.svg";
import tailwindIcon from "@/assets/tech/expertise/tailwindcss.svg";
import typescriptIcon from "@/assets/tech/expertise/typescript.svg";
import viteIcon from "@/assets/tech/expertise/vite.svg";

const description =
  "Proficient Front-End Developer with a proven track record in crafting immersive user experiences. Extensive expertise in HTML, CSS, and JavaScript, adept at transforming design concepts into responsive, high-performing web applications. Skilled in optimizing UI/UX, ensuring seamless functionality across various platforms and browsers. Strong knowledge of frameworks and libraries, coupled with a passion for staying updated on emerging technologies, driving innovation in Front-End development.";

const categories = [
  {
    label: "Languages",
    icons: [
      { icon: htmlIcon, name: "HTML" },
      { icon: cssIcon, name: "CSS" },
      { icon: javascriptIcon, name: "JavaScript" },
      { icon: typescriptIcon, name: "TypeScript" },
    ],
  },
  {
    label: "Frameworks",
    icons: [
      { icon: reactIcon, name: "React" },
      { icon: tailwindIcon, name: "Tailwindcss" },
    ],
  },
  {
    label: "Unit test",
    icons: [
      { icon: jestIcon, name: "Jest" },
      { icon: bunIcon, name: "Bun test" },
    ],
  },
  {
    label: "Build tools",
    icons: [
      { icon: viteIcon, name: "Vite" },
      { icon: bunIcon, name: "Bun" },
    ],
  },
  {
    label: "Others",
    icons: [
      { icon: npmIcon, name: "NPM" },
      { icon: eslintIcon, name: "Eslint" },
      { icon: biomeIcon, name: "Biome" },
    ],
  },
] as const;
---

<section data-slot="front-end" class="front-section relative overflow-hidden py-20 sm:py-24">
  <!-- Dot pattern background -->
  <div class="dot-pattern absolute inset-0"></div>

  <!-- Gradient orbs -->
  <div class="orb orb-1"></div>
  <div class="orb orb-2"></div>

  <div class="relative z-10 mx-auto max-w-6xl px-6">
    <div class="flex flex-col items-center gap-3 text-center mb-14">
      <Muted class="text-2xs font-semibold tracking-widest opacity-60">Crafting interfaces</Muted>
      <H2 class="border-0 text-3xl sm:text-4xl font-black tracking-tight">
        Front-End <span class="front-gradient-text">Development</span>
      </H2>
    </div>

    <!-- Editor window -->
    <div class="editor-window rounded-lg overflow-hidden">
      <!-- Title bar -->
      <div class="editor-titlebar flex items-center gap-3 px-4 py-3">
        <div class="flex items-center gap-1.5">
          <span class="dot dot-red"></span>
          <span class="dot dot-yellow"></span>
          <span class="dot dot-green"></span>
        </div>
        <span class="editor-filename">front-end.tsx</span>
        <div class="ml-auto flex items-center gap-2">
          <span class="editor-tab editor-tab-active">front-end.tsx</span>
          <span class="editor-tab">skills.ts</span>
        </div>
      </div>

      <!-- Editor body -->
      <div class="editor-body px-0 py-6 sm:py-8">
        <!-- Comment block as intro -->
        <div class="editor-line">
          <span class="line-number">1</span>
          <span class="code-comment">/**</span>
        </div>
        <div class="editor-line">
          <span class="line-number">2</span>
          <span class="code-comment">&nbsp;* Throughout my career, I've honed my expertise as a</span>
        </div>
        <div class="editor-line">
          <span class="line-number">3</span>
          <span class="code-comment">&nbsp;* Front-End Developer, refining and perfecting my skill set.</span>
        </div>
        <div class="editor-line mb-6">
          <span class="line-number">4</span>
          <span class="code-comment">&nbsp;*/</span>
        </div>

        <!-- Import statement as description -->
        <div class="editor-line mb-1">
          <span class="line-number">5</span>
          <span class="code-keyword">export</span>
          <span class="code-keyword"> const</span>
          <span class="code-variable"> profile</span>
          <span class="code-punctuation"> =</span>
          <span class="code-string"> `{description.slice(0, 60)}...</span>
        </div>
        <div class="editor-line mb-8">
          <span class="line-number">6</span>
          <span class="code-string">&nbsp; ...{description.slice(60, 130)}`</span>
          <span class="code-punctuation">;</span>
        </div>

        <!-- Blank line -->
        <div class="editor-line mb-2">
          <span class="line-number">7</span>
        </div>

        <!-- Categories as code blocks -->
        {
          categories.map(({ label, icons }, catIdx) => (
            <>
              <div class="editor-line">
                <span class="line-number">{8 + catIdx * 4}</span>
                <span class="code-keyword">const</span>
                <span class="code-function"> {label.replace(/\s+(.)/g, (_, c: string) => c.toUpperCase()).replace(/^(.)/, (c: string) => c.toLowerCase())}</span>
                <span class="code-punctuation">: </span>
                <span class="code-type">Stack[]</span>
                <span class="code-punctuation"> = [</span>
              </div>

              <div class="editor-line">
                <span class="line-number">{9 + catIdx * 4}</span>
                <span class="code-indent"></span>
                <div class="tech-modules">
                  {icons.map(({ icon, name }) => (
                    <div class="tech-module group">
                      <div class="tech-icon-wrapper">
                        <Image src={icon} alt={name} width={28} height={28} />
                      </div>
                      <span class="tech-name">{name}</span>
                    </div>
                  ))}
                </div>
              </div>

              <div class="editor-line mb-6">
                <span class="line-number">{10 + catIdx * 4}</span>
                <span class="code-punctuation">];</span>
              </div>
            </>
          ))
        }
      </div>

      <!-- Status bar -->
      <div class="editor-statusbar flex items-center justify-between px-4 py-1.5">
        <div class="flex items-center gap-3">
          <span class="status-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m18 16 4-4-4-4" />
              <path d="m6 8-4 4 4 4" />
              <path d="m14.5 4-5 16" />
            </svg>
            Front-End
          </span>
        </div>
        <div class="flex items-center gap-3">
          <span class="status-item">TypeScript React</span>
          <span class="status-item">UTF-8</span>
          <span class="status-item">Spaces: 2</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .front-gradient-text {
    background: linear-gradient(135deg, #cba6f7 0%, #89b4fa 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* Dot pattern */
  .dot-pattern {
    background-image: radial-gradient(
      circle,
      var(--color-primary-200) 1px,
      transparent 1px
    );
    background-size: 24px 24px;
    opacity: 0.5;
  }

  /* Floating gradient orbs */
  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.25;
    pointer-events: none;
  }

  .orb-1 {
    width: 400px;
    height: 400px;
    background: var(--color-primary-400);
    top: -100px;
    right: -100px;
  }

  .orb-2 {
    width: 350px;
    height: 350px;
    background: var(--color-secondary-400, var(--color-primary-300));
    bottom: -80px;
    left: -80px;
  }

  .editor-window {
    background: #1e1e2e;
    box-shadow: none;
    border: 1px solid #313244;
  }

  .editor-titlebar {
    background: #181825;
    border-bottom: 1px solid #313244;
  }

  .dot {
    display: block;
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .dot-red {
    background: #f38ba8;
  }

  .dot-yellow {
    background: #f9e2af;
  }

  .dot-green {
    background: #a6e3a1;
  }

  .editor-filename {
    font-family: "JetBrains Mono", "Fira Code", "Cascadia Code", monospace;
    font-size: 0.75rem;
    color: #cdd6f4;
  }

  .editor-tab {
    font-family: "JetBrains Mono", "Fira Code", "Cascadia Code", monospace;
    font-size: 0.7rem;
    color: #6c7086;
    padding: 0.2rem 0.75rem;
    border-radius: 0.25rem;
    cursor: default;
  }

  .editor-tab-active {
    color: #cdd6f4;
    background: #1e1e2e;
  }

  .editor-body {
    font-family: "JetBrains Mono", "Fira Code", "Cascadia Code", monospace;
    font-size: 0.8rem;
    line-height: 1.7;
    min-height: 300px;
  }

  .editor-line {
    display: flex;
    align-items: flex-start;
    padding: 0 1.5rem 0 0;
    white-space: pre;
  }

  .line-number {
    display: inline-block;
    width: 3.5rem;
    min-width: 3.5rem;
    text-align: right;
    padding-right: 1.25rem;
    color: #6c7086;
    user-select: none;
    font-size: 0.75rem;
  }

  .code-comment {
    color: #6c7086;
    font-style: italic;
  }

  .code-keyword {
    color: #cba6f7;
  }

  .code-variable {
    color: #89b4fa;
  }

  .code-function {
    color: #94e2d5;
  }

  .code-type {
    color: #f9e2af;
  }

  .code-string {
    color: #a6e3a1;
    font-style: italic;
    font-size: 0.75rem;
  }

  .code-punctuation {
    color: #6c7086;
  }

  .code-indent {
    display: inline-block;
    width: 1.5rem;
  }

  .tech-modules {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 0.25rem 0 0.25rem 1.5rem;
  }

  .tech-module {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: #313244;
    padding: 0.35rem 0.75rem;
    border-radius: 0.375rem;
    border: 1px solid #45475a;
    transition: all 0.2s ease;
    cursor: default;
  }

  .tech-module:hover {
    background: #45475a;
    border-color: #585b70;
    transform: translateY(-1px);
  }

  .tech-icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
  }

  .tech-name {
    color: #cdd6f4;
    font-family: "JetBrains Mono", "Fira Code", "Cascadia Code", monospace;
    font-size: 0.8rem;
    font-weight: 500;
  }

  .editor-statusbar {
    background: #181825;
    border-top: 1px solid #313244;
  }

  .status-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-family: "JetBrains Mono", "Fira Code", "Cascadia Code", monospace;
    font-size: 0.65rem;
    color: #a6adc8;
  }

  @media (max-width: 640px) {
    .editor-tab {
      display: none;
    }

    .editor-body {
      font-size: 0.7rem;
    }

    .tech-modules {
      padding-left: 0.5rem;
    }

    .line-number {
      width: 2.5rem;
      min-width: 2.5rem;
      padding-right: 0.75rem;
    }

    .code-string {
      font-size: 0.65rem;
    }
  }
</style>
