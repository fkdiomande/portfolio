---
import H2 from "@/components/ui/typography/H2.astro";
import Muted from "@/components/ui/typography/Muted.astro";
import { Image } from "astro:assets";
import biomeIcon from "@/assets/tech/expertise/biome.svg";
import bunIcon from "@/assets/tech/expertise/bun.svg";
import cssIcon from "@/assets/tech/expertise/css.svg";
import eslintIcon from "@/assets/tech/expertise/eslint.svg";
import htmlIcon from "@/assets/tech/expertise/html.svg";
import javascriptIcon from "@/assets/tech/expertise/javascript.svg";
import jestIcon from "@/assets/tech/expertise/jest.svg";
import npmIcon from "@/assets/tech/expertise/npm.svg";
import reactIcon from "@/assets/tech/expertise/react.svg";
import tailwindIcon from "@/assets/tech/expertise/tailwindcss.svg";
import typescriptIcon from "@/assets/tech/expertise/typescript.svg";
import viteIcon from "@/assets/tech/expertise/vite.svg";

const description =
  "Proficient Front-End Developer with a proven track record in crafting immersive user experiences. Extensive expertise in HTML, CSS, and JavaScript, adept at transforming design concepts into responsive, high-performing web applications. Skilled in optimizing UI/UX, ensuring seamless functionality across various platforms and browsers. Strong knowledge of frameworks and libraries, coupled with a passion for staying updated on emerging technologies, driving innovation in Front-End development.";

const categories = [
  {
    label: "Languages",
    icons: [
      { icon: htmlIcon, name: "HTML" },
      { icon: cssIcon, name: "CSS" },
      { icon: javascriptIcon, name: "JavaScript" },
      { icon: typescriptIcon, name: "TypeScript" },
    ],
  },
  {
    label: "Frameworks",
    icons: [
      { icon: reactIcon, name: "React" },
      { icon: tailwindIcon, name: "Tailwindcss" },
    ],
  },
  {
    label: "Unit test",
    icons: [
      { icon: jestIcon, name: "Jest" },
      { icon: bunIcon, name: "Bun test" },
    ],
  },
  {
    label: "Build tools",
    icons: [
      { icon: viteIcon, name: "Vite" },
      { icon: bunIcon, name: "Bun" },
    ],
  },
  {
    label: "Others",
    icons: [
      { icon: npmIcon, name: "NPM" },
      { icon: eslintIcon, name: "Eslint" },
      { icon: biomeIcon, name: "Biome" },
    ],
  },
] as const;
---

<section data-slot="front-end" class="front-section relative overflow-hidden py-20 sm:py-24">
  <!-- Dot pattern background -->
  <div class="absolute inset-0 bg-[radial-gradient(circle,var(--color-primary-200)_1px,transparent_1px)] [background-size:24px_24px] opacity-50"></div>

  <!-- Gradient orbs -->
  <div class="absolute rounded-full blur-[80px] opacity-25 pointer-events-none w-[400px] h-[400px] bg-primary-400 -top-[100px] -right-[100px]"></div>
  <div class="absolute rounded-full blur-[80px] opacity-25 pointer-events-none w-[350px] h-[350px] bg-secondary-400 -bottom-[80px] -left-[80px]"></div>

  <div class="relative z-10 mx-auto max-w-6xl px-6">
    <div class="flex flex-col items-center gap-3 text-center mb-14">
      <Muted class="text-2xs font-semibold tracking-widest opacity-60">Crafting interfaces</Muted>
      <H2 class="border-0 text-3xl sm:text-4xl font-black tracking-tight">
        Front-End <span class="bg-linear-to-br from-[#cba6f7] to-[#89b4fa] bg-clip-text text-transparent">Development</span>
      </H2>
    </div>

    <!-- Editor window -->
    <div class="rounded-lg overflow-hidden bg-[#1e1e2e] border border-[#313244]">
      <!-- Title bar -->
      <div class="flex items-center gap-3 px-4 py-3 bg-[#181825] border-b border-[#313244]">
        <div class="flex items-center gap-1.5">
          <span class="block w-3 h-3 rounded-full bg-[#f38ba8]"></span>
          <span class="block w-3 h-3 rounded-full bg-[#f9e2af]"></span>
          <span class="block w-3 h-3 rounded-full bg-[#a6e3a1]"></span>
        </div>
        <span class="font-mono text-xs text-[#cdd6f4]">front-end.tsx</span>
        <div class="ml-auto flex items-center gap-2">
          <span class="font-mono text-[0.7rem] py-[0.2rem] px-3 rounded-sm cursor-default text-[#cdd6f4] bg-[#1e1e2e] max-sm:hidden">front-end.tsx</span>
          <span class="font-mono text-[0.7rem] py-[0.2rem] px-3 rounded-sm cursor-default text-[#6c7086] max-sm:hidden">skills.ts</span>
        </div>
      </div>

      <!-- Editor body -->
      <div class="px-0 py-6 sm:py-8 font-mono text-[0.8rem] leading-[1.7] min-h-[300px] max-sm:text-[0.7rem]">
        <!-- Comment block as intro -->
        <div class="flex items-start pr-6 whitespace-pre">
          <span class="inline-block w-14 min-w-14 text-right pr-5 text-[#6c7086] select-none text-xs max-sm:w-10 max-sm:min-w-10 max-sm:pr-3">1</span>
          <span class="text-[#6c7086] italic">/**</span>
        </div>
        <div class="flex items-start pr-6 whitespace-pre">
          <span class="inline-block w-14 min-w-14 text-right pr-5 text-[#6c7086] select-none text-xs max-sm:w-10 max-sm:min-w-10 max-sm:pr-3">2</span>
          <span class="text-[#6c7086] italic">&nbsp;* Throughout my career, I've honed my expertise as a</span>
        </div>
        <div class="flex items-start pr-6 whitespace-pre">
          <span class="inline-block w-14 min-w-14 text-right pr-5 text-[#6c7086] select-none text-xs max-sm:w-10 max-sm:min-w-10 max-sm:pr-3">3</span>
          <span class="text-[#6c7086] italic">&nbsp;* Front-End Developer, refining and perfecting my skill set.</span>
        </div>
        <div class="flex items-start pr-6 whitespace-pre mb-6">
          <span class="inline-block w-14 min-w-14 text-right pr-5 text-[#6c7086] select-none text-xs max-sm:w-10 max-sm:min-w-10 max-sm:pr-3">4</span>
          <span class="text-[#6c7086] italic">&nbsp;*/</span>
        </div>

        <!-- Import statement as description -->
        <div class="flex items-start pr-6 whitespace-pre mb-1">
          <span class="inline-block w-14 min-w-14 text-right pr-5 text-[#6c7086] select-none text-xs max-sm:w-10 max-sm:min-w-10 max-sm:pr-3">5</span>
          <span class="text-[#cba6f7]">export</span>
          <span class="text-[#cba6f7]"> const</span>
          <span class="text-[#89b4fa]"> profile</span>
          <span class="text-[#6c7086]"> =</span>
          <span class="text-[#a6e3a1] italic text-xs max-sm:text-[0.65rem]"> `{description.slice(0, 60)}...</span>
        </div>
        <div class="flex items-start pr-6 whitespace-pre mb-8">
          <span class="inline-block w-14 min-w-14 text-right pr-5 text-[#6c7086] select-none text-xs max-sm:w-10 max-sm:min-w-10 max-sm:pr-3">6</span>
          <span class="text-[#a6e3a1] italic text-xs max-sm:text-[0.65rem]">&nbsp; ...{description.slice(60, 130)}`</span>
          <span class="text-[#6c7086]">;</span>
        </div>

        <!-- Blank line -->
        <div class="flex items-start pr-6 whitespace-pre mb-2">
          <span class="inline-block w-14 min-w-14 text-right pr-5 text-[#6c7086] select-none text-xs max-sm:w-10 max-sm:min-w-10 max-sm:pr-3">7</span>
        </div>

        <!-- Categories as code blocks -->
        {
          categories.map(({ label, icons }, catIdx) => (
            <>
              <div class="flex items-start pr-6 whitespace-pre">
                <span class="inline-block w-14 min-w-14 text-right pr-5 text-[#6c7086] select-none text-xs max-sm:w-10 max-sm:min-w-10 max-sm:pr-3">{8 + catIdx * 4}</span>
                <span class="text-[#cba6f7]">const</span>
                <span class="text-[#94e2d5]"> {label.replace(/\s+(.)/g, (_, c: string) => c.toUpperCase()).replace(/^(.)/, (c: string) => c.toLowerCase())}</span>
                <span class="text-[#6c7086]">: </span>
                <span class="text-[#f9e2af]">Stack[]</span>
                <span class="text-[#6c7086]"> = [</span>
              </div>

              <div class="flex items-start pr-6 whitespace-pre">
                <span class="inline-block w-14 min-w-14 text-right pr-5 text-[#6c7086] select-none text-xs max-sm:w-10 max-sm:min-w-10 max-sm:pr-3">{9 + catIdx * 4}</span>
                <span class="inline-block w-6"></span>
                <div class="flex flex-wrap gap-3 py-1 pl-6 max-sm:pl-2">
                  {icons.map(({ icon, name }) => (
                    <div class="group flex items-center gap-2 bg-[#313244] py-[0.35rem] px-3 rounded-md border border-[#45475a] transition-all duration-200 cursor-default hover:bg-[#45475a] hover:border-[#585b70] hover:-translate-y-px">
                      <div class="flex items-center justify-center w-7 h-7">
                        <Image src={icon} alt={name} width={28} height={28} />
                      </div>
                      <span class="text-[#cdd6f4] font-mono text-[0.8rem] font-medium">{name}</span>
                    </div>
                  ))}
                </div>
              </div>

              <div class="flex items-start pr-6 whitespace-pre mb-6">
                <span class="inline-block w-14 min-w-14 text-right pr-5 text-[#6c7086] select-none text-xs max-sm:w-10 max-sm:min-w-10 max-sm:pr-3">{10 + catIdx * 4}</span>
                <span class="text-[#6c7086]">];</span>
              </div>
            </>
          ))
        }
      </div>

      <!-- Status bar -->
      <div class="flex items-center justify-between px-4 py-1.5 bg-[#181825] border-t border-[#313244]">
        <div class="flex items-center gap-3">
          <span class="flex items-center gap-[0.35rem] font-mono text-[0.65rem] text-[#a6adc8]">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m18 16 4-4-4-4" />
              <path d="m6 8-4 4 4 4" />
              <path d="m14.5 4-5 16" />
            </svg>
            Front-End
          </span>
        </div>
        <div class="flex items-center gap-3">
          <span class="flex items-center gap-[0.35rem] font-mono text-[0.65rem] text-[#a6adc8]">TypeScript React</span>
          <span class="flex items-center gap-[0.35rem] font-mono text-[0.65rem] text-[#a6adc8]">UTF-8</span>
          <span class="flex items-center gap-[0.35rem] font-mono text-[0.65rem] text-[#a6adc8]">Spaces: 2</span>
        </div>
      </div>
    </div>
  </div>
</section>
