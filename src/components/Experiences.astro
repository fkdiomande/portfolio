---
import { Image } from "astro:assets";
import airLiquideLogo from "@/assets/companies/air-liquide.svg";
import deltaRmLogo from "@/assets/companies/delta-rm.png";
import mataLogo from "@/assets/companies/mata.svg";
import metaLogo from "@/assets/companies/meta.svg";
import ooneexLogo from "@/assets/companies/ooneex.svg";
import wiztrustLogo from "@/assets/companies/wiztrust.png";
import awsIcon from "@/assets/tech/expertise/aws.svg";
import dockerIcon from "@/assets/tech/expertise/docker.svg";
import langchainIcon from "@/assets/tech/expertise/langchain.svg";
import nodeIcon from "@/assets/tech/expertise/node.js.svg";
import pythonIcon from "@/assets/tech/expertise/python.svg";
import reactIcon from "@/assets/tech/expertise/react.svg";
import sqlIcon from "@/assets/tech/expertise/sql.svg";
import tailwindIcon from "@/assets/tech/expertise/tailwindcss.svg";
import terraformIcon from "@/assets/tech/expertise/terraform.svg";
import typescriptIcon from "@/assets/tech/expertise/typescript.svg";
import Card from "@/components/ui/card/Card.astro";
import CardContent from "@/components/ui/card/CardContent.astro";
import CardDescription from "@/components/ui/card/CardDescription.astro";
import CardHeader from "@/components/ui/card/CardHeader.astro";
import CardTitle from "@/components/ui/card/CardTitle.astro";
import Chip from "@/components/ui/chip/Chip.astro";
import Separator from "@/components/ui/separator/Separator.astro";
import H2 from "@/components/ui/typography/H2.astro";
import Muted from "@/components/ui/typography/Muted.astro";
import Small from "@/components/ui/typography/Small.astro";

const experiences = [
  {
    logo: ooneexLogo,
    company: "Ooneex",
    position: "Lead Developer",
    period: "Oct 2024 — Mar 2026",
    duration: "1.5 years",
    field: "EdTech / SaaS",
    description:
      "Ooneex is a vertical SaaS platform for medical education that unifies content management, scheduling, assessments, and analytics into a single classroom workspace. It empowers educators and students to organize, study, and track entire courses from one place.",
    features: [
      "Built an interactive classroom dashboard providing high-level course overviews with year-level tagging, ownership, and participant management",
      "Developed a rich resource library supporting books, videos, images, notes, MCQ decks, flashcard decks, and clinical case decks with AI-powered chat capabilities",
      "Engineered an agenda and events management system for tutorials, labs, workshops, and exams with priority tracking and weekly analytics",
      "Implemented a folder-based content organization system with per-topic resource counts, favorites, and granular access control",
      "Created a resource analytics engine with format distribution charts and top-folder rankings",
      "Designed a credits-based monetization system separating free and premium content folders",
    ],
    skills: [
      "SaaS architecture & multi-tenant design",
      "AI integration (RAG, conversational agents)",
      "Real-time data analytics & dashboards",
      "Payment & credits system design",
      "Team leadership & code review",
    ],
    tech: [
      { icon: reactIcon, name: "React" },
      { icon: tailwindIcon, name: "Tailwind CSS" },
      { icon: typescriptIcon, name: "TypeScript" },
      { icon: nodeIcon, name: "Node.js" },
      { icon: pythonIcon, name: "Python" },
      { icon: dockerIcon, name: "Docker" },
      { icon: awsIcon, name: "AWS" },
      { icon: terraformIcon, name: "Terraform" },
      { icon: langchainIcon, name: "LangChain" },
    ],
  },
  {
    logo: mataLogo,
    company: "Mata Capital",
    position: "Lead Developer",
    period: "Sep 2020 — Oct 2024",
    duration: "4 years",
    field: "Real Estate / FinTech",
    description:
      "Mata Capital is an independent real estate investment firm managing approximately €2.4 billion in assets across France and Germany. The firm combines investment management, investor solutions, and asset management with a strong focus on innovation, ESG, and long-term value creation.",
    features: [
      "Built internal tools for an independent, management-owned investment firm operating with full strategic autonomy across fund decisions",
      "Developed an integrated asset management platform covering the entire value chain — acquisition, active management, property operations, and disposal",
      "Engineered cross-border investment workflows supporting the Franco-German positioning with offices in Paris, Lyon, and Hamburg",
      "Implemented portfolio dashboards for three distinct strategies: Core Plus (€1.4B), Value-Added (€810M), and Private Equity Real Estate (€150M)",
      "Created data-driven decision tools leveraging advanced analytics to optimize operational management across 70+ professionals",
      "Built ESG reporting and responsible investing modules integrating sustainability metrics at the heart of investment strategies",
    ],
    skills: [
      "Financial data modeling & portfolio analytics",
      "Cross-border compliance workflows",
      "ESG reporting & sustainability tracking",
      "Data-driven decision support tools",
      "Scalable architecture for regulated environments",
    ],
    tech: [
      { icon: reactIcon, name: "React" },
      { icon: tailwindIcon, name: "Tailwind CSS" },
      { icon: typescriptIcon, name: "TypeScript" },
      { icon: nodeIcon, name: "Node.js" },
      { icon: pythonIcon, name: "Python" },
      { icon: dockerIcon, name: "Docker" },
      { icon: awsIcon, name: "AWS" },
      { icon: terraformIcon, name: "Terraform" },
      { icon: langchainIcon, name: "LangChain" },
    ],
  },
  {
    logo: deltaRmLogo,
    company: "Delta RM",
    position: "Lead Developer",
    period: "Jan 2019 — Sep 2020",
    duration: "1.5 years",
    field: "GRC / SaaS",
    description:
      "Delta RM is a French SaaS GRC platform that centralizes and digitalizes enterprise risk management — risk mapping, incidents, insurance, internal control, audit and prevention — in a powerful, secure and highly configurable tool. Built “by risk managers for risk managers”, it serves companies of all sizes with unlimited usage, strong data security in France, rich integrations, and collaborative features designed to improve decision-making and risk culture.",
    features: [
      "Built a risk mapping module for enterprise-wide risk identification, analysis, and interactive dashboards",
      "Developed an incident and claims management system with full lifecycle tracking and reporting",
      "Engineered an insurance management module covering policies, coverages, and linked risks",
      "Implemented risk prevention action plans with assignment, deadlines, and follow-up workflows",
      "Created an internal control engine supporting level 1 and level 2 controls with evidence collection",
      "Delivered an internal audit module for audit planning, execution, findings, and recommendation tracking",
    ],
    skills: [
      "GRC domain modeling & risk engines",
      "Highly configurable multi-tenant SaaS",
      "Compliance-grade data security",
      "Workflow & approval system design",
      "Collaborative enterprise tooling",
    ],
    tech: [
      { icon: reactIcon, name: "React" },
      { icon: pythonIcon, name: "Python" },
      { icon: nodeIcon, name: "Node.js" },
      { icon: dockerIcon, name: "Docker" },
      { icon: awsIcon, name: "AWS" },
    ],
  },
  {
    logo: airLiquideLogo,
    company: "Air Liquide",
    position: "Senior Developer — Freelance",
    period: "Jan 2018 — Sep 2019",
    duration: "1.5 years",
    field: "Industry / Healthcare",
    description:
      "Air Liquide is a global leader in industrial and medical gases, technologies, and related services, operating in 59 countries and serving over 4 million customers and patients. The group supports key sectors like industry, healthcare, energy transition, and semiconductors, combining strong financial performance with sustainability goals such as reducing CO₂ emissions and improving healthcare access worldwide.",
    features: [
      "Built internal platforms for a world leader in gases, technologies and services operating at scale across industry and healthcare",
      "Engineered multi-region applications supporting operations across 59 countries and a workforce of roughly 65,000 employees",
      "Developed customer and patient portals serving a base of over 4 million users worldwide",
      "Implemented tooling around core molecules and technologies — oxygen, nitrogen, hydrogen, CO₂ — for industry, energy transition, and health",
      "Delivered financial and investment dashboards tracking multi-billion-euro sales, net income, and capital allocation decisions",
      "Created sustainability reporting modules tracking CO₂ reduction targets and extra-financial commitments across environment, health, and inclusion",
      "Contributed to R&D tooling supporting 5,600+ researchers, patent pipelines, and heavy data and digital initiatives",
      "Built sector-specific integrations spanning multinationals, semiconductors, hospitals, and local craftspeople",
    ],
    skills: [
      "Enterprise-scale multi-region platforms",
      "Industrial & healthcare domain modeling",
      "Sustainability & ESG reporting",
      "High-availability customer portals",
      "Data-intensive R&D tooling",
    ],
    tech: [
      { icon: reactIcon, name: "React" },
      { icon: nodeIcon, name: "Node.js" },
      { icon: pythonIcon, name: "Python" },
      { icon: awsIcon, name: "AWS" },
    ],
  },
  {
    logo: metaLogo,
    company: "Facebook",
    position: "Software Engineer",
    period: "Sep 2012 — Oct 2017",
    duration: "5 years",
    field: "Big Tech",
    description:
      "During my academic journey, I had the privilege of joining Facebook as part of my engineering curriculum. Working alongside some of the industry's finest engineers, I gained invaluable insights into cutting-edge technologies and honed my skills in collaboration and knowledge sharing. After three enriching years, I joined the back-office team to help develop and improve the company's internal tools, gaining deep exposure to international, multidisciplinary teamwork, agile methodologies, and complex problem-solving in a dynamic professional environment.",
    features: [
      "Contributed to R&D initiatives alongside senior engineers, exploring cutting-edge technologies and patterns",
      "Designed and implemented algorithms powering back-office tooling and data-processing pipelines",
      "Built internal APIs and integrated a wide range of external APIs across the back-office ecosystem",
      "Authored technical documentation for internal tools to accelerate team onboarding and knowledge sharing",
      "Added new features to existing internal tools within a 80-engineer international team",
      "Wired microservices into official APIs and implemented a scalable microservices architecture",
      "Optimized application performance and hardened security across back-office services",
      "Collaborated closely with international development teams using agile methodologies",
    ],
    skills: [
      "Low-level programming in C",
      "Microservices architecture & API design",
      "Algorithm design & performance tuning",
      "Large-team agile collaboration",
      "Technical documentation & knowledge sharing",
    ],
    tech: [
      { icon: reactIcon, name: "React" },
      { icon: nodeIcon, name: "Node.js" },
      { icon: pythonIcon, name: "Python" },
      { icon: sqlIcon, name: "SQL" },
    ],
  },
  {
    logo: wiztrustLogo,
    company: "Wiztrust",
    position: "Software Engineer",
    period: "Oct 2011 — Sep 2012",
    duration: "1 year",
    field: "PR Tech / SaaS",
    description:
      "Wiztrust is an all-in-one, GDPR-compliant PR and communications platform that helps corporate communication teams manage newsrooms, media databases, multichannel press distribution, and performance analytics. Its Wiztrust Protect module leverages blockchain certification to secure and verify corporate information, fighting misinformation and strengthening trust with media, investors, and stakeholders.",
    features: [
      "Built an all-in-one PR management platform unifying newsrooms, CRM, campaigns, emailing, newswires, social media, and media monitoring with personalized press reviews",
      "Developed customizable, SEO- and GEO-optimized newsrooms tuned for search engines and generative engines, meeting banking- and insurance-grade security standards",
      "Engineered Wiztrust Protect to certify and timestamp corporate content on blockchain, proving authenticity and reducing corporate liability against fake news",
      "Created a public one-click verification portal enabling journalists and investors to instantly validate the origin and integrity of corporate information",
      "Implemented the Wiztrust Data analytics suite combining automated and human-curated insights with quarterly dashboards and KPIs to measure communication ROI",
      "Delivered enterprise-grade compliance and security — full GDPR, EU hosting on Google Cloud, SSO, granular roles, and high SLAs for listed companies and financial institutions",
    ],
    skills: [
      "Blockchain certification & content integrity",
      "Multichannel distribution & CRM workflows",
      "SEO / GEO optimization for newsrooms",
      "GDPR compliance & enterprise security",
      "Analytics pipelines & KPI dashboards",
    ],
    tech: [
      { icon: reactIcon, name: "React" },
      { icon: nodeIcon, name: "Node.js" },
      { icon: pythonIcon, name: "Python" },
      { icon: awsIcon, name: "AWS" },
    ],
  },
] as const;
---

<section id="experiences" data-slot="experiences" class="relative overflow-hidden py-20 sm:py-24">
  <!-- Background -->
  <div class="absolute inset-0 bg-[radial-gradient(circle,rgba(245,158,11,0.03)_1px,transparent_1px)] [background-size:32px_32px]"></div>
  <div class="absolute rounded-full blur-[120px] opacity-10 pointer-events-none w-125 h-125 bg-amber-500 -top-37.5 -right-30"></div>
  <div class="absolute rounded-full blur-[120px] opacity-10 pointer-events-none w-112.5 h-112.5 bg-red-500 -bottom-37.5 -left-30"></div>

  <div class="relative z-10 mx-auto max-w-6xl px-6">
    <div class="flex flex-col items-center gap-3 text-center mb-14">
      <Muted class="text-2xs font-semibold tracking-widest opacity-60">Where I've been</Muted>
      <H2 class="border-0 text-3xl sm:text-4xl font-black tracking-tight">
        My <span class="bg-linear-to-br from-[#f59e0b] via-[#ef4444] to-[#ec4899] bg-clip-text text-transparent">Experiences</span>
      </H2>
    </div>

    <!-- Timeline -->
    <div class="flex flex-col gap-10">
      {experiences.map((exp, i) => (
        <Card hoverable class="p-7! cursor-default! animate-[exp-fade-in_0.5s_ease-out_both]" style={`animation-delay: ${i * 0.15}s;`}>
          <!-- Header -->
          <CardHeader class="gap-3!">
            <div class="flex items-center gap-4 flex-wrap">
              <div class="bg-card text-card-foreground overflow-hidden rounded p-2 ring-[0.2px] ring-card-ring flex items-center justify-center size-12 shrink-0">
                <Image src={exp.logo} alt={exp.company} class="w-full h-full object-contain" />
              </div>
              <div class="flex-1 min-w-0">
                <CardTitle class="text-xl! font-extrabold! tracking-tight">{exp.company}</CardTitle>
                <div class="flex items-center gap-2 mt-1 flex-wrap">
                  <Small class="font-mono text-secondary">{exp.position}</Small>
                  <Muted class="text-xs">·</Muted>
                  <Muted class="font-mono text-[0.72rem]">{exp.period}</Muted>
                  <Muted class="text-xs">·</Muted>
                  <Muted class="font-mono text-[0.72rem]">{exp.duration}</Muted>
                </div>
              </div>
              <span class="font-mono text-2xs font-bold uppercase tracking-widest px-3 py-1.5 rounded-full text-white shrink-0 bg-linear-to-br from-primary to-secondary shadow-[0_2px_12px_rgba(var(--color-primary),0.3),0_0_20px_rgba(var(--color-secondary),0.15)]">{exp.field}</span>
            </div>
          </CardHeader>

          <!-- Description -->
          <CardContent>
            <CardDescription class="text-[0.85rem]! leading-7!">{exp.description}</CardDescription>
          </CardContent>

          <Separator />

          <!-- Features -->
          <CardContent class="flex flex-col gap-3">
            <Small class="flex items-center gap-2 font-mono font-bold! uppercase tracking-wider text-secondary">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="9 11 12 14 22 4" />
                <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" />
              </svg>
              Key Contributions
            </Small>
            <ul class="flex flex-col gap-2 list-none p-0 m-0">
              {exp.features.map((feature) => (
                <li class="flex items-start gap-2.5 text-[0.8rem] leading-relaxed text-muted-foreground">
                  <span class="shrink-0 size-1.25 rounded-full bg-amber-500 mt-[0.45rem] opacity-70"></span>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
          </CardContent>

          <!-- Skills developed -->
          <CardContent class="flex flex-col gap-3">
            <Small class="flex items-center gap-2 font-mono font-bold! uppercase tracking-wider text-secondary">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z" />
              </svg>
              Skills Developed
            </Small>
            <div class="flex flex-wrap gap-2">
              {exp.skills.map((skill) => (
                <Chip>{skill}</Chip>
              ))}
            </div>
          </CardContent>

          <!-- Tech stack -->
          <CardContent class="flex flex-col gap-3">
            <Small class="flex items-center gap-2 font-mono font-bold! uppercase tracking-wider text-secondary">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m18 16 4-4-4-4" />
                <path d="m6 8-4 4 4 4" />
                <path d="m14.5 4-5 16" />
              </svg>
              Tech Stack
            </Small>
            <div class="flex flex-wrap gap-2">
              {exp.tech.map(({ icon, name }) => (
                <div class="flex items-center gap-2 px-2.5 py-1.5 bg-card text-card-foreground rounded-[var(--radius)] shadow-[0_0_0_0.4px_var(--color-card-ring)] transition-all duration-[0.25s] cursor-default hover:shadow-[0_0_0_0.4px_var(--color-ring-alt)] hover:-translate-y-0.5">
                  <div class="flex items-center justify-center w-5 h-5">
                    <Image src={icon} alt={name} width={20} height={20} />
                  </div>
                  <span class="font-mono text-[0.72rem] font-semibold max-sm:text-[0.66rem]">{name}</span>
                </div>
              ))}
            </div>
          </CardContent>
        </Card>
      ))}
    </div>
  </div>
</section>

<style is:global>
  @keyframes exp-fade-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
