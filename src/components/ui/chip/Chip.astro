---
import type { HTMLAttributes } from "astro/types";
import { cva } from "class-variance-authority";
import { cn } from "@/lib/utils";

const chipVariants = cva(
  "inline-flex items-center justify-center font-mono text-2xs font-semibold px-3 py-1.5 rounded-full w-fit whitespace-nowrap shrink-0 transition-all",
  {
    variants: {
      variant: {
        default: "text-violet-600 bg-violet-600/6",
        primary: "text-primary bg-primary/6",
        secondary: "text-secondary bg-secondary/6",
        info: "text-info-700 bg-info-500/6",
        success: "text-success-700 bg-success-500/6",
        warning: "text-warning-700 bg-warning-500/6",
        danger: "text-danger-700 bg-danger-500/6",
        neutral: "text-neutral-700 bg-neutral-500/6",
      },
    },
    defaultVariants: {
      variant: "default",
    },
  },
);

interface Props extends HTMLAttributes<"span"> {
  variant?: "default" | "primary" | "secondary" | "info" | "success" | "warning" | "danger" | "neutral";
}

const { variant = "default", class: className, ...rest } = Astro.props;
---

<span data-slot="chip" class={cn(chipVariants({ variant, className }))} {...rest}>
  <slot />
</span>
