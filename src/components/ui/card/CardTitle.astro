---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {}
const { class: className, ...props } = Astro.props;
---

<div
	data-slot="card-title"
	class:list={[
		"p-0 text-sm 2xl:text-base leading-normal font-medium group-data-[size=sm]/card:text-xs 2xl:group-data-[size=sm]/card:text-sm",
		className,
	]}
	{...props}
>
	<slot />
</div>
