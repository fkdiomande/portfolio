---
import type { HTMLAttributes } from "astro/types";
import { cn } from "@/lib/utils";

interface Props extends HTMLAttributes<"textarea"> {}

const { class: className, ...rest } = Astro.props;
---

<textarea
  data-slot="textarea"
  class={cn(
    "border-input focus-visible:border-ring focus-visible:ring-ring/50 aria-invalid:ring-destructive/20 aria-invalid:border-destructive rounded border bg-transparent px-2 2xl:px-2.5 py-1.5 2xl:py-2 text-xs 2xl:text-base transition-[color,box-shadow] focus-visible:ring-[3px] aria-invalid:ring-[3px] md:text-xs 2xl:md:text-sm placeholder:text-muted-foreground flex field-sizing-content min-h-12 2xl:min-h-16 w-full outline-none disabled:cursor-not-allowed disabled:opacity-50",
    className,
  )}
  {...rest}
/>
