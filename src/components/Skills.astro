---
import H2 from "@/components/ui/typography/H2.astro";
import Muted from "@/components/ui/typography/Muted.astro";

const skills = [
  {
    title: "Front-End",
    description: "Optimize website performance and accessibility",
    color: "var(--color-primary-600)",
    // lucide: code-2
    icon: `<path d="m18 16 4-4-4-4"/><path d="m6 8-4 4 4 4"/><path d="m14.5 4-5 16"/>`,
  },
  {
    title: "Back-End",
    description: "Design, develop, and maintain robust server-side applications",
    color: "var(--color-info-500)",
    // lucide: server
    icon: `<rect width="20" height="8" x="2" y="2" rx="2" ry="2"/><rect width="20" height="8" x="2" y="14" rx="2" ry="2"/><line x1="6" x2="6.01" y1="6" y2="6"/><line x1="6" x2="6.01" y1="18" y2="18"/>`,
  },
  {
    title: "AI & Agent",
    description: "Build intelligent agents and AI-powered product features",
    color: "var(--color-ai)",
    // lucide: bot
    icon: `<path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/>`,
  },
  {
    title: "Dev & Ops",
    description: "Design and implement scalable and resilient systems",
    color: "var(--color-secondary-500)",
    // lucide: cloud-cog
    icon: `<circle cx="12" cy="17" r="3"/><path d="M4.2 15.1A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.24"/><path d="M12 13.5V14"/><path d="M12 20v.5"/><path d="m14.6 15.5-.4.3"/><path d="m9.8 18.2-.4.3"/><path d="M9.8 15.8 9.4 15.5"/><path d="m14.6 18.5-.4-.3"/><path d="M15.5 17h-.5"/><path d="M9 17h-.5"/>`,
  },
  {
    title: "Leader",
    description: "Guide and mentor a team of developers",
    color: "var(--color-location)",
    // lucide: users
    icon: `<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>`,
  },
  {
    title: "Tools",
    description: "Facilitate smoother collaboration among team members",
    color: "var(--color-warning-500)",
    // lucide: wrench
    icon: `<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>`,
  },
] as const;
---

<section data-slot="skills" class="skills-section relative overflow-hidden py-20 sm:py-24">
  <div class="relative z-10 mx-auto max-w-6xl px-6">
    <div class="flex flex-col items-center gap-3 text-center mb-14">
      <Muted class="text-2xs font-semibold tracking-widest opacity-60">What I do</Muted>
      <H2 class="border-0 text-3xl sm:text-4xl font-black tracking-tight">
        Skills & <span class="bg-linear-to-br from-primary to-secondary bg-clip-text text-transparent">Expertise</span>
      </H2>
    </div>

    <div class="grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {
        skills.map(({ title, description, color, icon }) => (
          <article class="skill-item group" style={`--skill-color: ${color};`}>
            <div class="flex items-center gap-4 mb-4">
              <div class="relative flex size-16 shrink-0 items-center justify-center rounded-md transition-transform duration-300 group-hover:-translate-y-1 group-hover:-rotate-3 bg-[var(--skill-color)]">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="32"
                  height="32"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  class="text-white"
                  set:html={icon}
                />
                <span class="hidden absolute inset-0 rounded-md opacity-0 group-hover:opacity-100 transition-opacity duration-300"></span>
              </div>
              <h3 class="text-2xl sm:text-3xl font-black tracking-tight leading-none text-[var(--skill-color)]">
                {title}
              </h3>
            </div>
            <p class="text-base font-bold leading-snug max-w-xs text-[var(--skill-color)]">
              {description}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
