---
import { Image } from "astro:assets";
import airLiquide from "@/assets/companies/air-liquide.jpg";
import babbler from "@/assets/companies/babbler.png";
import deltaRm from "@/assets/companies/delta-rm.webp";
import mata from "@/assets/companies/mata.png";
import metaLogo from "@/assets/companies/meta.png";
import ooneex from "@/assets/companies/ooneex.svg";
import wiztrust from "@/assets/companies/wiztrust.png";
import profileImage from "@/assets/franck-diomande.jpeg";
import epitech from "@/assets/schools/epitech.png";
import esgi from "@/assets/schools/esgi.png";
import esiee from "@/assets/schools/esiee.svg";
import emailIcon from "@/assets/social/email.svg";
import githubIcon from "@/assets/social/github.svg";
import instagramIcon from "@/assets/social/instagram.svg";
import linkedinIcon from "@/assets/social/linkedin.svg";
import awsIcon from "@/assets/tech/expertise/aws.svg";
import dockerIcon from "@/assets/tech/expertise/docker.svg";
import fastApiIcon from "@/assets/tech/expertise/fast-api.svg";
import nestIcon from "@/assets/tech/expertise/nest.js.svg";
import nodeIcon from "@/assets/tech/expertise/node.js.svg";
import postgresIcon from "@/assets/tech/expertise/postgres.svg";
import pythonIcon from "@/assets/tech/expertise/python.svg";
import rabbitMqIcon from "@/assets/tech/expertise/rabbit-mq.svg";
import reactIcon from "@/assets/tech/expertise/react.svg";
import redisIcon from "@/assets/tech/expertise/redis.svg";
import tailwindIcon from "@/assets/tech/expertise/tailwindcss.svg";
import terraformIcon from "@/assets/tech/expertise/terraform.svg";
import typescriptIcon from "@/assets/tech/expertise/typescript.svg";

const techStack = [
  { icon: typescriptIcon, name: "TypeScript" },
  { icon: reactIcon, name: "React" },
  { icon: nodeIcon, name: "Node.js" },
  { icon: nestIcon, name: "NestJS" },
  { icon: pythonIcon, name: "Python" },
  { icon: fastApiIcon, name: "FastAPI" },
  { icon: postgresIcon, name: "PostgreSQL" },
  { icon: redisIcon, name: "Redis" },
  { icon: dockerIcon, name: "Docker" },
  { icon: awsIcon, name: "AWS" },
  { icon: terraformIcon, name: "Terraform" },
  { icon: tailwindIcon, name: "Tailwind CSS" },
  { icon: rabbitMqIcon, name: "RabbitMQ" },
];

const companies = [
  { logo: metaLogo, name: "Meta" },
  { logo: airLiquide, name: "Air Liquide" },
  { logo: wiztrust, name: "Wiztrust" },
  { logo: babbler, name: "Babbler" },
  { logo: deltaRm, name: "Delta RM" },
  { logo: mata, name: "Mata" },
  { logo: ooneex, name: "Ooneex" },
];

const schools = [
  { logo: epitech, name: "Epitech" },
  { logo: esgi, name: "ESGI" },
  { logo: esiee, name: "ESIEE" },
];

const socials = [
  { icon: githubIcon, name: "GitHub", href: "https://github.com/ooneex" },
  {
    icon: linkedinIcon,
    name: "LinkedIn",
    href: "https://linkedin.com/in/franck-diomande",
  },
  {
    icon: instagramIcon,
    name: "Instagram",
    href: "https://instagram.com/fkdiomande",
  },
  { icon: emailIcon, name: "Email", href: "mailto:franck@ooneex.com" },
];
---

<section data-slot="hero" class="flex flex-col items-center gap-10 py-16 px-6 max-w-3xl mx-auto">
  <div class="flex flex-col items-center gap-5">
    <div class="size-32 rounded-full overflow-hidden ring-3 ring-primary/20 ring-offset-2 ring-offset-background">
      <Image
        src={profileImage}
        alt="Franck Diomande"
        width={256}
        height={256}
        class="size-full object-cover"
      />
    </div>

    <div class="text-center space-y-2">
      <h1 class="text-3xl font-bold text-foreground tracking-tight">
        Franck Diomande
      </h1>
      <p class="text-lg font-medium text-secondary">
        Fullstack Web Developer
      </p>
      <p class="text-sm text-muted-foreground max-w-md">
        Taking ideas to production. I design, build, and ship end-to-end web applications with modern tools and best practices.
      </p>
    </div>

    <div class="flex gap-3">
      {socials.map(({ icon, name, href }) => (
        <a
          href={href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={name}
          class="size-9 flex items-center justify-center rounded-full border border-border hover:bg-accent transition-colors"
        >
          <Image src={icon} alt={name} width={18} height={18} />
        </a>
      ))}
    </div>
  </div>

  <div class="w-full space-y-3">
    <h2 class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">
      Tech Stack
    </h2>
    <div class="flex flex-wrap gap-2">
      {techStack.map(({ icon, name }) => (
        <div class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-md border border-border bg-card text-xs font-medium text-card-foreground hover:bg-accent transition-colors">
          <Image src={icon} alt={name} width={16} height={16} />
          <span>{name}</span>
        </div>
      ))}
    </div>
  </div>

  <div class="w-full space-y-3">
    <h2 class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">
      Experience
    </h2>
    <div class="flex flex-wrap gap-3 items-center">
      {companies.map(({ logo, name }) => (
        <div class="size-10 rounded-md border border-border bg-card p-1.5 flex items-center justify-center hover:bg-accent transition-colors" title={name}>
          <Image src={logo} alt={name} width={28} height={28} class="object-contain size-full" />
        </div>
      ))}
    </div>
  </div>

  <div class="w-full space-y-3">
    <h2 class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">
      Education
    </h2>
    <div class="flex flex-wrap gap-3 items-center">
      {schools.map(({ logo, name }) => (
        <div class="size-10 rounded-md border border-border bg-card p-1.5 flex items-center justify-center hover:bg-accent transition-colors" title={name}>
          <Image src={logo} alt={name} width={28} height={28} class="object-contain size-full" />
        </div>
      ))}
    </div>
  </div>
</section>
