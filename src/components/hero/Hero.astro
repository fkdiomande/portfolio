---
import { Image } from "astro:assets";
import airLiquide from "@/assets/companies/air-liquide.jpg";
import babbler from "@/assets/companies/babbler.png";
import deltaRm from "@/assets/companies/delta-rm.webp";
import mata from "@/assets/companies/mata.png";
import metaLogo from "@/assets/companies/meta.png";
import ooneex from "@/assets/companies/ooneex.svg";
import wiztrust from "@/assets/companies/wiztrust.png";
import profileImage from "@/assets/franck-diomande.jpeg";
import epitech from "@/assets/schools/epitech.png";
import esgi from "@/assets/schools/esgi.png";
import esiee from "@/assets/schools/esiee.svg";
import emailIcon from "@/assets/social/email.svg";
import githubIcon from "@/assets/social/github.svg";
import instagramIcon from "@/assets/social/instagram.svg";
import linkedinIcon from "@/assets/social/linkedin.svg";
import awsIcon from "@/assets/tech/expertise/aws.svg";
import dockerIcon from "@/assets/tech/expertise/docker.svg";
import fastApiIcon from "@/assets/tech/expertise/fast-api.svg";
import nestIcon from "@/assets/tech/expertise/nest.js.svg";
import nodeIcon from "@/assets/tech/expertise/node.js.svg";
import postgresIcon from "@/assets/tech/expertise/postgres.svg";
import pythonIcon from "@/assets/tech/expertise/python.svg";
import rabbitMqIcon from "@/assets/tech/expertise/rabbit-mq.svg";
import reactIcon from "@/assets/tech/expertise/react.svg";
import redisIcon from "@/assets/tech/expertise/redis.svg";
import tailwindIcon from "@/assets/tech/expertise/tailwindcss.svg";
import terraformIcon from "@/assets/tech/expertise/terraform.svg";
import typescriptIcon from "@/assets/tech/expertise/typescript.svg";
import Avatar from "@/components/ui/avatar/Avatar.astro";
import AvatarFallback from "@/components/ui/avatar/AvatarFallback.astro";
import AvatarImage from "@/components/ui/avatar/AvatarImage.astro";
import Button from "@/components/ui/button/Button.astro";
import H1 from "@/components/ui/typography/H1.astro";
import Large from "@/components/ui/typography/Large.astro";
import Lead from "@/components/ui/typography/Lead.astro";
import Muted from "@/components/ui/typography/Muted.astro";
import Small from "@/components/ui/typography/Small.astro";

const techCategories = [
  {
    label: "Frontend",
    icons: [
      { icon: typescriptIcon, name: "TypeScript" },
      { icon: reactIcon, name: "React" },
      { icon: tailwindIcon, name: "Tailwind CSS" },
    ],
  },
  {
    label: "Backend",
    icons: [
      { icon: nodeIcon, name: "Node.js" },
      { icon: nestIcon, name: "NestJS" },
      { icon: pythonIcon, name: "Python" },
      { icon: fastApiIcon, name: "FastAPI" },
    ],
  },
  {
    label: "Databases",
    icons: [
      { icon: postgresIcon, name: "PostgreSQL" },
      { icon: redisIcon, name: "Redis" },
      { icon: rabbitMqIcon, name: "RabbitMQ" },
    ],
  },
  {
    label: "DevOps",
    icons: [
      { icon: dockerIcon, name: "Docker" },
      { icon: awsIcon, name: "AWS" },
      { icon: terraformIcon, name: "Terraform" },
    ],
  },
];

const companies = [
  { logo: metaLogo, name: "Meta" },
  { logo: airLiquide, name: "Air Liquide" },
  { logo: wiztrust, name: "Wiztrust" },
  { logo: babbler, name: "Babbler" },
  { logo: deltaRm, name: "Delta RM" },
  { logo: mata, name: "Mata" },
  { logo: ooneex, name: "Ooneex" },
];

const schools = [
  { logo: epitech, name: "Epitech" },
  { logo: esgi, name: "ESGI" },
  { logo: esiee, name: "ESIEE" },
];

const socials = [
  { icon: githubIcon, name: "GitHub", href: "https://github.com/ooneex" },
  { icon: linkedinIcon, name: "LinkedIn", href: "https://linkedin.com/in/franck-diomande" },
  { icon: instagramIcon, name: "Instagram", href: "https://instagram.com/fkdiomande" },
  { icon: emailIcon, name: "Email", href: "mailto:franck@ooneex.com" },
];
---

<section data-slot="hero" class="hero-section relative min-h-screen overflow-hidden">
  <!-- Animated gradient background -->
  <div class="hero-bg absolute inset-0 -z-10">
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-6xl px-6 pt-16 pb-12 flex flex-col gap-16">
    <!-- Main hero content -->
    <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-16">
      <!-- Left: Text content -->
      <div class="hero-left flex-1 flex flex-col gap-6 text-center lg:text-left">
        <div class="inline-flex items-center gap-3 self-center lg:self-start">
          <span class="relative flex h-3 w-3">
            <span class="relative inline-flex h-3 w-3 rounded-full hero-gradient-dot"></span>
          </span>
          <span class="text-2xl font-black tracking-tight hero-gradient-text">14+</span>
          <Small class="tracking-wider uppercase text-muted-foreground">years crafting digital products</Small>
        </div>

        <div>
          <H1 class="hero-name text-5xl sm:text-6xl lg:text-7xl font-black tracking-tighter leading-none">
            <span class="block">Franck</span>
            <span class="block hero-gradient-text uppercase">Diomande</span>
          </H1>
        </div>

        <Large class="text-lg sm:text-xl text-foreground/80">
          Fullstack Web Developer
        </Large>

        <Lead class="text-sm sm:text-base max-w-md mx-auto lg:mx-0 leading-relaxed">
          Taking ideas to production. I design, build, and ship end-to-end web applications with modern tools and best practices.
        </Lead>

        <div class="flex gap-3 justify-center lg:justify-start">
          <Button href="mailto:franck@ooneex.com" size="xl">
            Get in touch
          </Button>
          <Button href="/resume" variant="outline" size="xl">
            View Resume
          </Button>
        </div>

        <div class="flex gap-2 justify-center lg:justify-start">
          {socials.map(({ icon, name, href }) => (
            <Button
              href={href}
              variant="ghost"
              size="icon-sm"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={name}
            >
              <Image src={icon} alt={name} width={18} height={18} />
            </Button>
          ))}
        </div>
      </div>

      <!-- Right: Avatar -->
      <div class="hero-right relative shrink-0">
        <div class="relative">
          <!-- Glow ring behind avatar -->
          <div class="absolute inset-0 rounded-full bg-linear-to-br from-primary/30 via-secondary/20 to-primary/30 blur-2xl"></div>

          <!-- Avatar -->
          <div class="relative flex items-center justify-center">
            <div class="avatar-ring relative rounded-full p-1">
              <Avatar size="xl" class="size-44! sm:size-48! lg:size-56! ring-2 ring-white/20">
                <AvatarImage src={profileImage.src} alt="Franck Diomande" />
              </Avatar>
            </div>
          </div>

        </div>
      </div>
    </div>

    <!-- Tech stack -->
    <div class="tech-stack flex flex-wrap justify-center gap-x-8 gap-y-5">
      {techCategories.map(({ label, icons }) => (
        <div class="flex flex-col items-start gap-2">
          <Muted class="text-2xs font-semibold tracking-widest opacity-60">{label}</Muted>
          <div class="flex items-center -space-x-2">
            {icons.map(({ icon, name }) => (
              <div class="tech-icon group relative size-10 rounded-full border-2 border-background bg-card flex items-center justify-center transition-all duration-300 hover:z-10 hover:scale-125 hover:-translate-y-1" title={name}>
                <Image src={icon} alt={name} width={20} height={20} />
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Card Fan: Experience & Education -->
    <div class="card-fan-section grid grid-cols-1 md:grid-cols-2 gap-16 md:gap-8">
      <!-- Experience fan -->
      <div class="flex flex-col items-center gap-6">
        <div class="flex items-center gap-2">
          <div class="h-1 w-6 rounded-full bg-linear-to-r from-primary to-secondary"></div>
          <Small class="uppercase tracking-wider text-muted-foreground">Experience</Small>
        </div>
        <div class="fan fan-left relative h-56 w-72">
          {companies.map(({ logo, name }, i) => {
            const total = companies.length;
            const mid = (total - 1) / 2;
            const angle = (i - mid) * 8;
            const yShift = Math.abs(i - mid) * 6;
            return (
              <div
                class="fan-card group absolute left-1/2 bottom-0 w-28 origin-bottom"
                style={`--fan-rotate: ${angle}deg; --fan-y: ${yShift}px; --fan-index: ${total - Math.abs(i - mid)}; z-index: ${total - Math.abs(i - mid)};`}
              >
                <div class="glass-card rounded-xl p-3 flex flex-col items-center gap-2 transition-all duration-300 group-hover:scale-110 group-hover:z-50! group-hover:shadow-lg">
                  <Avatar size="lg" class="rounded-lg after:rounded-lg">
                    <AvatarImage
                      src={typeof logo === "string" ? logo : logo.src}
                      alt={name}
                      class="rounded-lg object-contain p-1"
                    />
                    <AvatarFallback class="rounded-lg text-2xs">{name.slice(0, 2)}</AvatarFallback>
                  </Avatar>
                  <Small class="text-2xs font-medium text-center leading-tight whitespace-nowrap">{name}</Small>
                </div>
              </div>
            );
          })}
        </div>
      </div>

      <!-- Education fan -->
      <div class="flex flex-col items-center gap-6">
        <div class="flex items-center gap-2">
          <div class="h-1 w-6 rounded-full bg-linear-to-r from-secondary to-primary"></div>
          <Small class="uppercase tracking-wider text-muted-foreground">Education</Small>
        </div>
        <div class="fan fan-right relative h-56 w-72">
          {schools.map(({ logo, name }, i) => {
            const total = schools.length;
            const mid = (total - 1) / 2;
            const angle = (i - mid) * 10;
            const yShift = Math.abs(i - mid) * 8;
            return (
              <div
                class="fan-card group absolute left-1/2 bottom-0 w-28 origin-bottom"
                style={`--fan-rotate: ${angle}deg; --fan-y: ${yShift}px; --fan-index: ${total - Math.abs(i - mid)}; z-index: ${total - Math.abs(i - mid)};`}
              >
                <div class="glass-card rounded-xl p-3 flex flex-col items-center gap-2 transition-all duration-300 group-hover:scale-110 group-hover:z-50! group-hover:shadow-lg">
                  <Avatar size="lg" class="rounded-lg after:rounded-lg">
                    <AvatarImage
                      src={typeof logo === "string" ? logo : logo.src}
                      alt={name}
                      class="rounded-lg object-contain p-1"
                    />
                    <AvatarFallback class="rounded-lg text-2xs">{name.slice(0, 2)}</AvatarFallback>
                  </Avatar>
                  <Small class="text-2xs font-medium text-center leading-tight whitespace-nowrap">{name}</Small>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-bg {
    background: var(--color-background);
  }

  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.4;
  }

  .orb-1 {
    width: 600px;
    height: 600px;
    background: var(--color-primary-300);
    top: -200px;
    right: -100px;
  }

  .orb-2 {
    width: 500px;
    height: 500px;
    background: var(--color-secondary-300);
    bottom: -150px;
    left: -100px;
  }

  .orb-3 {
    width: 400px;
    height: 400px;
    background: var(--color-primary-400);
    top: calc(50% - 200px);
    left: calc(50% - 200px);
    opacity: 0.2;
  }

  .hero-gradient-text {
    background: linear-gradient(
      135deg,
      var(--color-primary) 0%,
      var(--color-primary-500) 30%,
      var(--color-secondary) 70%,
      var(--color-secondary-400) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-gradient-dot {
    background: linear-gradient(
      135deg,
      var(--color-primary) 0%,
      var(--color-secondary) 100%
    );
  }

  .avatar-ring {
    background: linear-gradient(
      135deg,
      var(--color-primary) 0%,
      var(--color-secondary) 50%,
      var(--color-primary) 100%
    );
  }

  .glass-card {
    background: color-mix(in oklch, var(--color-card) 70%, transparent);
    border: 1px solid color-mix(in oklch, var(--color-border) 50%, transparent);
    backdrop-filter: blur(12px);
  }

  .tech-icon {
    box-shadow: none;
  }

  .fan-card {
    transform: translateX(-50%) rotate(var(--fan-rotate)) translateY(calc(-1 * var(--fan-y)));
    transition: transform 0.3s ease, z-index 0s;
  }

  .fan-card:hover {
    transform: translateX(-50%) rotate(0deg) translateY(-30px);
    z-index: 50 !important;
  }
</style>
