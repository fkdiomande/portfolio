---
import { Image } from "astro:assets";
import H2 from "@/components/ui/typography/H2.astro";
import Muted from "@/components/ui/typography/Muted.astro";
import figmaIcon from "@/assets/tech/expertise/figma.svg";
import sketchIcon from "@/assets/tech/expertise/sketch.svg";
import jiraIcon from "@/assets/tech/expertise/jira.svg";
import notionIcon from "@/assets/tech/expertise/notion.svg";
import linearIcon from "@/assets/tech/expertise/linear.svg";
const description =
  "I am a dedicated professional known for my proficiency in a diverse array of tools such as Figma, Sketch, Jira, Notion, and Linear. Beyond technical expertise, my strength lies in my soft skills, which significantly impact my work:";

const skills = [
  {
    title: "Adaptability",
    text: "I swiftly acclimate to new tools and methodologies, embracing innovation and remaining flexible to the dynamic demands of the industry. This allows me to seamlessly navigate between platforms like Figma and Sketch for design, while efficiently managing tasks and workflows through Jira, Notion, and Linear.",
  },
  {
    title: "Collaboration",
    text: "My adeptness in collaborative platforms like Notion fosters effective teamwork. I thrive on transparent communication, ensuring that all team members are on the same page, regardless of the tools or methods we use.",
  },
  {
    title: "Problem-Solving",
    text: "I approach challenges with a problem-solving mindset. My ability to identify issues and craft efficient solutions is a cornerstone of my work ethic.",
  },
  {
    title: "Organization and Planning",
    text: "Utilizing tools like Jira and Linear, I meticulously plan and organize projects, ensuring smooth workflows, timely deliveries, and a structured approach to complex tasks.",
  },
  {
    title: "Creativity and Design Thinking",
    text: "Platforms like Figma and Sketch are my playground for ideation and design. My eye for detail and creative flair allow me to craft visually appealing and user-friendly solutions.",
  },
] as const;

const tools = [
  { icon: figmaIcon, name: "Figma" },
  { icon: sketchIcon, name: "Sketch" },
  { icon: jiraIcon, name: "Jira" },
  { icon: notionIcon, name: "Notion" },
  { icon: linearIcon, name: "Linear" },
] as const;
---

<section data-slot="soft-skills" class="soft-section relative overflow-hidden py-20 sm:py-24">
  <!-- Background pattern -->
  <div class="soft-bg absolute inset-0"></div>

  <!-- Gradient orbs -->
  <div class="soft-orb soft-orb-1"></div>
  <div class="soft-orb soft-orb-2"></div>

  <div class="relative z-10 mx-auto max-w-6xl px-6">
    <div class="flex flex-col items-center gap-3 text-center mb-10">
      <Muted class="text-2xs font-semibold tracking-widest opacity-60">Beyond the code</Muted>
      <H2 class="border-0 text-3xl sm:text-4xl font-black tracking-tight">
        Soft <span class="soft-gradient-text">Skills</span>
      </H2>
    </div>

    <!-- Description -->
    <div class="mx-auto max-w-3xl text-center mb-14">
      <p class="text-base sm:text-lg leading-relaxed text-muted-foreground">{description}</p>
    </div>

    <!-- Checklist cards -->
    <div class="soft-checklist">
      {skills.map((skill, i) => (
        <div class="soft-check-item" style={`animation-delay: ${i * 0.1}s;`}>
          <div class="soft-check-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="20 6 9 17 4 12" />
            </svg>
          </div>
          <div class="soft-check-content">
            <h3 class="soft-check-title">{skill.title}</h3>
            <p class="soft-check-desc">{skill.text}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Tools grid -->
    <div class="soft-tools-section mt-14">
      <div class="soft-tools-grid">
        {tools.map(({ icon, name }) => (
          <div class="soft-tool-item">
            <div class="soft-tool-icon">
              <Image src={icon} alt={name} width={28} height={28} />
            </div>
            <span class="soft-tool-name">{name}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .soft-gradient-text {
    background: linear-gradient(135deg, #7c3aed 0%, #a855f7 50%, #6366f1 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .soft-bg {
    background-color: transparent;
    background-image: radial-gradient(circle, rgba(124, 58, 237, 0.04) 1px, transparent 1px);
    background-size: 28px 28px;
  }

  .soft-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.08;
    pointer-events: none;
  }

  .soft-orb-1 {
    width: 550px;
    height: 550px;
    background: #7c3aed;
    top: -180px;
    left: -120px;
  }

  .soft-orb-2 {
    width: 450px;
    height: 450px;
    background: #a855f7;
    bottom: -180px;
    right: -120px;
  }

  /* Checklist layout */
  .soft-checklist {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 48rem;
    margin: 0 auto;
  }

  .soft-check-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    background: var(--color-card);
    color: var(--color-card-foreground);
    border-radius: var(--radius);
    box-shadow: 0 0 0 0.4px var(--color-card-ring);
    transition: all 0.3s ease;
    animation: soft-fade-in 0.5s ease-out both;
  }

  .soft-check-item:hover {
    box-shadow: 0 0 0 0.4px var(--color-ring-alt);
    transform: translateY(-2px);
  }

  @keyframes soft-fade-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .soft-check-icon {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: linear-gradient(135deg, #7c3aed, #a855f7);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    margin-top: 0.15rem;
  }

  .soft-check-content {
    flex: 1;
    min-width: 0;
  }

  .soft-check-title {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 0.35rem;
  }

  .soft-check-desc {
    font-size: 0.82rem;
    line-height: 1.7;
    color: #64748b;
  }

  /* Tools section */
  .soft-tools-section {
    display: flex;
    justify-content: center;
  }

  .soft-tools-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }

  .soft-tool-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 1rem;
    background: var(--color-card);
    color: var(--color-card-foreground);
    border-radius: var(--radius);
    box-shadow: 0 0 0 0.4px var(--color-card-ring);
    transition: all 0.25s ease;
    cursor: default;
  }

  .soft-tool-item:hover {
    box-shadow: 0 0 0 0.4px var(--color-ring-alt);
    transform: translateY(-2px);
  }

  .soft-tool-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
  }

  .soft-tool-name {
    font-family: "JetBrains Mono", "Fira Code", monospace;
    font-size: 0.8rem;
    font-weight: 600;
  }

  /* Responsive */
  @media (max-width: 640px) {
    .soft-check-item {
      padding: 1rem 1.25rem;
    }

    .soft-check-desc {
      font-size: 0.75rem;
    }

    .soft-tool-name {
      font-size: 0.72rem;
    }
  }
</style>
